<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Story 1638: the tests host an interactive Blazor Server page, which needs _framework/blazor.web.js. Since .NET 9
         that file ships in Microsoft.AspNetCore.App.Internal.Assets, which the SDK adds by itself to a Web project,
         at the version of the runtime; this asks the SDK for it in this test project, which is not one. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <!-- 10.0.13, not 10.0.3: bUnit pulls Components.Web 10.0.10 and the SignalR client below pulls
         SignalR.Client.Core 10.0.13, which require at least those. Test-project only, so it does not
         affect what the packages ship. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <!-- Hosts Novior.MentorAgent.Server in-memory: TestServer gives a real hub + real endpoints without
         a socket, which is the only way to test the transport layer deterministically. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <!-- Renders the .razor components without a browser. Nothing else can reach a component's
         markup, and the components carry real logic: the bubble's Markdown renderer is the
         XSS boundary, and the badges encode three-valued state in CSS classes. -->
    <PackageReference Include="bunit" Version="2.9.0" />
    <!-- The real Chat Completions client over a recording HTTP handler, no network: what a request carries on the
         wire — its tools, its tool_choice, where ChatOptions.Instructions lands among the messages — is the
         provider client's mapping, which no fake IChatClient can show (story 526). Same version as
         Microsoft.Extensions.AI in the library. Test-project only. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <!-- Story 1638, slice B: a recipe reaches a row of a virtualized QuickGrid in the interactive test page. Test-project
         only: the library does not reference it. GeneratePathProperty: the host of the tests serves its JS module. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" Version="10.0.3" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 1569, slice B: the documentation file of the AutoMentor's candidate services in CandidateTests, next to the
         assembly as the compiler would write it. The test project does not generate one. -->
    <None Include="Discovery\CandidateDocs.xml" Link="Novior.MentorAgent.Tests.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- Story 1638: served by the interactive host of RecipeBrowserTests. The property comes from the package's targets. -->
    <None Include="$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js" Link="Interactive\blazor.web.js" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(BlazorFrameworkStaticWebAssetRoot)' != ''" />
    <!-- Story 1638, slice B: QuickGrid's own module, which the grid imports, served by the same host. -->
    <None Include="$(PkgMicrosoft_AspNetCore_Components_QuickGrid)\staticwebassets\QuickGrid.razor.js" Link="Interactive\QuickGrid.razor.js"
          CopyToOutputDirectory="PreserveNewest" Condition="'$(PkgMicrosoft_AspNetCore_Components_QuickGrid)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novior.MentorAgent\Novior.MentorAgent.csproj" />
    <ProjectReference Include="..\Novior.MentorAgent.Declarative\Novior.MentorAgent.Declarative.csproj" />
    <ProjectReference Include="..\Novior.MentorAgent.Tests.App\Novior.MentorAgent.Tests.App.csproj" />
    <ProjectReference Include="..\Novior.MentorAgent.Tests.Rules\Novior.MentorAgent.Tests.Rules.csproj" />
    <ProjectReference Include="..\Novior.MentorAgent.Server\Novior.MentorAgent.Server.csproj" />
    <ProjectReference Include="..\Novior.MentorAgent.Blazor\Novior.MentorAgent.Blazor.csproj" />
    <ProjectReference Include="..\Novior.MentorAgent.Scanner\Novior.MentorAgent.Scanner.csproj" />
  </ItemGroup>

  <!-- Story 1635, slice B: the package's own targets embed a manifest of the pages in this assembly, as they do in an
       application that references the package; ManifestTests reads it. -->
  <PropertyGroup>
    <MentorUiManifest>$(MSBuildThisFileDirectory)Pages\mentor-ui-manifest.test.json</MentorUiManifest>
  </PropertyGroup>
  <Import Project="..\Novior.MentorAgent\buildTransitive\Novior.MentorAgent.targets" />

</Project>