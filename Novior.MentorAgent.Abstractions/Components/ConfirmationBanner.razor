@using Novior.MentorAgent.Abstractions.Core
@using Novior.MentorAgent.Abstractions.Models
@inject MentorLocalizer L

<div class="bm-confirm">
    <div class="bm-confirm__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
            <line x1="12" y1="9" x2="12" y2="13"/>
            <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
    </div>
    <div class="bm-confirm__body">
        <p class="bm-confirm__title">@L.Get("confirm.title")</p>
        <p class="bm-confirm__desc" title="@Request.Message">@Request.Message</p>
    </div>
    <div class="bm-confirm__actions">
        <button class="bm-btn bm-btn--ghost"   @onclick="async () => await OnCancel.InvokeAsync()">@L.Get("confirm.cancel")</button>
        <button class="bm-btn bm-btn--primary"  @onclick="async () => await OnConfirm.InvokeAsync()">@L.Get("confirm.ok")</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ConfirmationRequest Request   { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback       OnConfirm { get; set; }
    [Parameter, EditorRequired] public EventCallback       OnCancel  { get; set; }
}
