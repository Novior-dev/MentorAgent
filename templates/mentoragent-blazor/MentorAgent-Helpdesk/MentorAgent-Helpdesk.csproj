<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The model key lives in the user secrets of this project, never in appsettings.json:
         dotnet user-secrets set "Assistant:ApiKey" "<your key>" -->
    <UserSecretsId>8f3c1d2a-5b6e-4f70-9a1b-2c3d4e5f6a7b</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Novior.MentorAgent" Version="1.3.0" />
    <!-- MentorAgent does not bring a provider SDK: the application references the one it uses. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
  </ItemGroup>

</Project>
