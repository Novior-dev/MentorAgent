<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Package identity — Version, Authors, License, Symbols inherited from Directory.Build.props -->
    <PackageId>Novior.MentorAgent.Server</PackageId>
    <Title>Novior.MentorAgent.Server</Title>
    <Description>Expose MentorAgent as a universal AI backend from any ASP.NET Core application. Adds a SignalR hub (/mentor-hub), SSE streaming endpoint (/mentor/chat), MCP server, and A2A agent — no Blazor required.</Description>
    <PackageTags>aspnetcore;webapi;minimal-api;signalr;sse;server-sent-events;ai;chatbot;assistant;agent;multi-agent;mcp;model-context-protocol;a2a;agent-to-agent;react;angular;vue;mobile;maui;headless;blazor;blazor-wasm;blazor-auto;openai;azure-openai;ollama;rag;memory;skills;mentor;dotnet;csharp</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>IconMA.png</PackageIcon>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\NOTICE" Pack="true" PackagePath="\" />
    <None Include="..\Novior.MentorAgent\IconMA.png" Pack="true" PackagePath="IconMA.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Novior.MentorAgent\Novior.MentorAgent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Story 105: the MCP server and the A2A agent endpoints moved here from MentorAgent. Both packages
         require Microsoft.AspNetCore.App; in the core they kept every MAUI target but Windows from
         compiling. A2A.AspNetCore, not Microsoft.Agents.AI.Hosting.A2A.AspNetCore which the core used to
         reference: the endpoints only call the A2A SDK's own AddA2AAgent / MapA2A / MapWellKnownAgentCard,
         and the Agent Framework hosting packages would add nothing but preview dependencies. -->
    <PackageReference Include="A2A.AspNetCore" Version="1.0.0-preview2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

</Project>
